# Copiar a .env.local y completar con los datos de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo se usa en el servidor (Server Actions / route handlers), nunca se expone al
# cliente. Necesaria para el alta de empleados (auth.admin.createUser).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clave de la API de Anthropic (console.anthropic.com > API Keys). Solo se usa en
# el servidor, para leer las fotos del cuaderno de ventas (modulo Finanzas). Sin
# ella el modulo funciona igual, pero los montos se cargan a mano.
ANTHROPIC_API_KEY=sk-ant-...
